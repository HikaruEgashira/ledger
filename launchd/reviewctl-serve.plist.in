<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AQUA_GLOBAL_CONFIG</key>
		<string>@HOME@/aqua.yaml</string>
		<key>AQUA_LOG_LEVEL</key>
		<string>error</string>
		<key>GHTKN_AGENT_SOCKET</key>
		<string>@HOME@/.cache/ghtkn/agent.sock</string>
		<key>GHTKN_APP</key>
		<string>@GHTKN_READ_APP@</string>
		<key>GHTKN_BACKEND</key>
		<string>agent</string>
		<key>REVIEWCTL_GH</key>
		<string>@HOME@/bin/gh</string>
		<key>PATH</key>
		<string>@HOME@/bin:@HOME@/.local/bin:@HOME@/.local/share/aquaproj-aqua/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>UV_CACHE_DIR</key>
		<string>@REPO_ROOT@/.uv-cache</string>
		<key>XDG_CACHE_HOME</key>
		<string>@HOME@/ghq/.cache</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>@LABEL_PREFIX@.reviewctl-serve</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>@REPO_ROOT@/app/node_modules/.bin/vp</string>
		<string>run</string>
		<string>start</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@REPO_ROOT@/logs/reviewctl-serve.error.log</string>
	<key>StandardOutPath</key>
	<string>@REPO_ROOT@/logs/reviewctl-serve.log</string>
	<key>WorkingDirectory</key>
	<string>@REPO_ROOT@/app</string>
</dict>
</plist>
