<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL_PREFIX@.review-team-poller</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>@REPO_ROOT@/scripts/active-hours.sh</string>
        <string>@HOME@/.local/share/aquaproj-aqua/bin/bun</string>
        <string>@REPO_ROOT@/app/src/review-poller.ts</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>AQUA_GLOBAL_CONFIG</key>
        <string>@HOME@/aqua.yaml</string>
        <key>AQUA_LOG_LEVEL</key>
        <string>error</string>
        <key>GHTKN_AGENT_SOCKET</key>
        <string>@HOME@/.cache/ghtkn/agent.sock</string>
        <key>GHTKN_APP</key>
        <string>@GHTKN_READ_APP@</string>
        <key>GHTKN_BACKEND</key>
        <string>agent</string>
        <key>PATH</key>
        <string>@HOME@/.local/bin:@HOME@/bin:@HOME@/.local/share/aquaproj-aqua/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>XDG_CACHE_HOME</key>
        <string>@HOME@/ghq/.cache</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>@REPO_ROOT@</string>


    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>@REPO_ROOT@/logs/review-poller/poller.log</string>

    <key>StandardErrorPath</key>
    <string>@REPO_ROOT@/logs/review-poller/poller.error.log</string>
</dict>
</plist>
